#!/bin/bash
# =================================================================================================
# GPU LSF job serving a small embedding model for the ShinkaEvolve baseline runs.
#
# Shinka's default novelty gate embeds every proposed program and rejects near-duplicates
# (code_embed_sim_threshold 0.99). Its stock embedding model is OpenAI's text-embedding-3-small,
# but there is no OPENAI_API_KEY on this cluster - so we serve Qwen3-Embedding-0.6B locally and
# address it with the same local/<model>@http://host:port/v1 scheme as the chat servers
# (shinka/embed/client.py parses it identically).
#
# ONE server is enough for the whole campaign: each shinka run embeds ~1 short program per
# ~1000s eval slot, a trivial load. jobs/shinka_run.bsub reads jobs/vllm_embed_host.txt and
# passes the full model string via --embedding_model.
#
# SUBMIT (before any shinka_run job)
#   cd ~/work/projects/phd/learning_evolve/src
#   mkdir -p jobs/logs
#   bsub < jobs/vllm_embed.bsub
#   bjobs -w                            # wait for RUN
#   cat jobs/vllm_embed_host.txt        # e.g. rng-dl01-w26n05
# =================================================================================================

#BSUB -J vllm_embed
#BSUB -o jobs/logs/vllm_embed.%J.out
#BSUB -e jobs/logs/vllm_embed.%J.err
#BSUB -n 8
#BSUB -R span[hosts=1]
#BSUB -M 32768MB
#BSUB -gpu "num=1"
#BSUB -W 24:00
#BSUB -q batch_h200
#BSUB -P BH-000557-01
#BSUB -G rb_bd_dlp_rng-dl01_cr_AIQ_employees

set -uo pipefail

source /fs/applications/modules/current/init/bash
module load proxy4server-access/2.0
sleep 1
source /fs/applications/p4s-access/2.0/ActivateP4S.sh -a

module unload cuda
module load cuda/12.6.0

cd ~/projects/phd/learning_evolve/src || exit 1
source ~/envs/bin/activate            # the vLLM env (separate from src/.venv)

nvidia-smi || { echo "ERROR: no GPU on this node"; exit 1; }

hostname > jobs/vllm_embed_host.txt
trap 'rm -f jobs/vllm_embed_host.txt' EXIT
echo "[job] serving embeddings on $(hostname):8003"

# Pooling model: vLLM auto-detects the embed runner; no reasoning parser / kv-cache flags apply.
vllm serve Qwen/Qwen3-Embedding-0.6B \
    --host 0.0.0.0 --port 8003 \
    --gpu-memory-utilization 0.30
