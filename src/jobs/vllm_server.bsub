#!/bin/bash
# =================================================================================================
# GPU LSF job that serves the model and publishes its hostname for the driver job to find.
#
# One server serves every sweep (ICL is decode-bound; a second server buys nothing). Submit this
# first, wait for jobs/vllm_host.txt to appear, then submit jobs/icl_sweep.bsub.
#
# SUBMIT
#   cd ~/projects/phd/learning_evolve/src
#   mkdir -p jobs/logs
#   bsub < jobs/vllm_server.bsub
#   bjobs -w                      # wait for RUN
#   cat jobs/vllm_host.txt        # e.g. rng-dl01-w26n05
# =================================================================================================

#BSUB -J vllm_qwen
#BSUB -o jobs/logs/vllm.%J.out
#BSUB -e jobs/logs/vllm.%J.err
#BSUB -n 16
#BSUB -R span[hosts=1]
#BSUB -M 65536MB
#BSUB -gpu "num=1"
#BSUB -W 24:00
#BSUB -q batch_h200
#BSUB -P BH-000557-01
#BSUB -G rb_bd_dlp_rng-dl01_cr_AIQ_employees

set -uo pipefail

source /fs/applications/modules/current/init/bash
module load proxy4server-access/2.0
sleep 1
source /fs/applications/p4s-access/2.0/ActivateP4S.sh -a

module unload cuda
module load cuda/12.6.0

cd ~/projects/phd/learning_evolve/src || exit 1
source ~/envs/bin/activate            # the vLLM env (separate from src/.venv)

nvidia-smi || { echo "ERROR: no GPU on this node"; exit 1; }

# Publish the node so the driver job can reach us. --host 0.0.0.0 is required: bound to localhost
# the server is invisible from any other node.
hostname > jobs/vllm_host.txt
trap 'rm -f jobs/vllm_host.txt' EXIT
echo "[job] serving on $(hostname):8001"

vllm serve Qwen/Qwen3.6-27B-FP8 \
    --host 0.0.0.0 --port 8001 \
    --tensor-parallel-size 1 \
    --async-scheduling \
    --gpu-memory-utilization 0.90 \
    --max-model-len 128000 \
    --max-num-seqs 256 \
    --max-num-batched-tokens 16384 \
    --enable-prefix-caching \
    --reasoning-parser qwen3 \
    --kv-cache-dtype fp8
