# claude-up -- bring this node up for a CLAUDE CODE coding-agent run, and say what it found.
#
# SOURCE IT, do not execute it:
#
#     source ~/bin/claude-up
#
# It has to export ANTHROPIC_BASE_URL and the rest of Claude Code's environment into your
# shell, and a child process cannot do that. Run it once per node, and again in every new
# shell on that node -- it starts only what is missing, so repeating it is always safe.
#
# This is the twin of ~/bin/agent-up. Same node, same relay, same vLLM, same six prompts;
# the harness is the only thing that changes, which is the whole point of running both.
# Two structural differences from agent-up:
#
#   * no session database. Claude Code keeps its state in $CLAUDE_CONFIG_DIR, which is set
#     per run folder, so there is nothing node-wide to start and nothing to collide.
#   * one extra hop. Claude Code speaks the Anthropic Messages format and nothing else;
#     vLLM speaks OpenAI and nothing else. LiteLLM on :4000 translates between them.
#     bnbcode is OpenAI-native and talks to the relay directly.
#
# What it checks, in order:
#   1. where you are      -- host, LSF job, cores
#   2. the binary         -- claude on PATH
#   3. the relay          -- listening on this node? and is a live vLLM behind it?
#   4. the shim           -- LiteLLM up, counting tokens with Qwen's tokenizer, and
#                            answering a real /v1/messages round trip
#   5. this shell         -- exports Claude Code's environment
#
# No `set -e`: this file is sourced, and a failed check must not kill the user's shell.

# Executing this in a child process would do all the work and then throw away the one thing
# that has to survive -- the exported environment -- leaving Claude Code trying to reach
# api.anthropic.com with no credentials. Refuse rather than half-work.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  echo "claude-up must be SOURCED, not executed:" >&2
  echo "    source ~/bin/claude-up" >&2
  exit 1
fi

_cu_exp="$HOME/work/learning_evolve/coding_agent_evolve/experiments"
_cu_yaml="$_cu_exp/litellm_claude.yaml"
_cu_guard="$_cu_exp/claude_guard.json"
_cu_relay_url="http://127.0.0.1:9001/v1"
_cu_jobs="gpu2:8001,gpu6:8002"
_cu_port="${CC_PROXY_PORT:-4000}"
_cu_litellm="$HOME/venvs/ccproxy/bin/litellm"
_cu_host="$(hostname -s)"
_cu_log="$HOME/agent_runs/relay.$_cu_host.log"
_cu_plog="$HOME/agent_runs/litellm.$_cu_host.log"
_cu_bad=0
printf '\n'

# --- 1. where are we ------------------------------------------------------------------
_cu_cores="$(nproc)"
_cu_job="$(bjobs -w 2>/dev/null | awk -v h="$_cu_host" '$3=="RUN" && $6 ~ h {print $7" ("$1")"; exit}')"
if [ -z "$_cu_job" ]; then
  echo "Where   : $_cu_host, $_cu_cores cores -- but no LSF job of yours is running here."
  echo "          If this is a login node, stop: a cgroup caps you at 5 cores while nproc"
  echo "          reports $_cu_cores, and evaluation runs ~12x slower. Get an interactive job first."
  _cu_bad=1
else
  echo "Where   : $_cu_host, $_cu_cores cores, LSF job $_cu_job."
fi

# --- 2. the binary --------------------------------------------------------------------
# ~/.local/bin is not on the default PATH here, and `claude` lives there as a symlink into
# ~/.local/share/claude/versions/. Prepend rather than report a failure the user can do
# nothing about.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH"; export PATH ;; esac
if command -v claude >/dev/null 2>&1; then
  echo "Binary  : claude $(claude --version 2>/dev/null | awk '{print $1}') at $(command -v claude)."
else
  echo "Binary  : MISSING -- no 'claude' on PATH, and none at ~/.local/bin/claude."
  echo "          It cannot be installed from here: the Bosch proxy returns 403 on"
  echo "          downloads.claude.ai. Sideload the binary from WSL, see"
  echo "          ~/work/learning_evolve/coding_agent_evolve/experiments/OPERATOR_NOTES.md."
  _cu_bad=1
fi

# --- 3. the relay ---------------------------------------------------------------------
# Shared with the bnbcode arm: same process, same port, same log. If agent-up already ran
# on this node the relay is up and this is a no-op -- and vice versa.
#
# Port binding and health are different questions. A bound port answering 503 means the
# relay is fine and no vLLM is -- starting a second relay would only fail on EADDRINUSE.
if (exec 3<>/dev/tcp/127.0.0.1/9001) 2>/dev/null; then
  echo "Relay   : already running on this node. Left as is."
else
  mkdir -p "$HOME/agent_runs"
  nohup python3 "$_cu_exp/llm_relay.py" --jobs "$_cu_jobs" --verbose \
        < /dev/null >> "$_cu_log" 2>&1 &
  disown 2>/dev/null
  sleep 5
  if (exec 3<>/dev/tcp/127.0.0.1/9001) 2>/dev/null; then
    echo "Relay   : started on this node (log: $_cu_log)."
  else
    echo "Relay   : FAILED to start. Last lines of $_cu_log:"
    tail -5 "$_cu_log" 2>/dev/null | sed 's/^/          /'
    _cu_bad=1
  fi
fi

_cu_models="$(curl -sS --noproxy '*' --max-time 20 "$_cu_relay_url/models" 2>&1)"
case "$_cu_models" in
  *'"data"'*)
    _cu_up="$(grep 'upstream ->' "$_cu_log" 2>/dev/null | tail -1 | sed 's/.*upstream -> //')"
    echo "LLM     : answering${_cu_up:+ -- currently $_cu_up}." ;;
  *'no live vLLM upstream'*)
    echo "LLM     : NOT available. The relay is healthy but no tool-capable vLLM is alive."
    echo "          Check 'bjobs -w' for gpu2 / gpu6, and remember gpu6 serves on port 8002,"
    echo "          not 8001. The relay retries by itself once one comes back."
    _cu_bad=1 ;;
  *)
    echo "LLM     : unexpected reply from the relay:"
    printf '          %.120s\n' "$_cu_models"
    _cu_bad=1 ;;
esac

# --- 4. the Anthropic-format shim -----------------------------------------------------
_cu_base="$(grep -o 'api_base:.*' "$_cu_yaml" 2>/dev/null | head -1 | sed 's/api_base: *//')"
if [ ! -f "$_cu_yaml" ]; then
  echo "Shim    : MISSING config -- $_cu_yaml is not there."
  _cu_bad=1
elif [ "$_cu_base" != "$_cu_relay_url" ]; then
  echo "Shim    : WRONG upstream -- litellm_claude.yaml points at '$_cu_base', not the relay."
  echo "          Fix api_base in $_cu_yaml:"
  echo "              api_base: $_cu_relay_url"
  _cu_bad=1
elif [ ! -x "$_cu_litellm" ]; then
  echo "Shim    : MISSING -- no litellm at $_cu_litellm. Provision ~/venvs/ccproxy."
  _cu_bad=1
elif curl -sf -m 3 "http://127.0.0.1:$_cu_port/health/liveliness" >/dev/null 2>&1; then
  echo "Shim    : LiteLLM already running on :$_cu_port. Left as is."
else
  # The tokenizer must resolve from the shared HF cache, never the hub: compute nodes are
  # behind the corporate proxy and a hub call would either hang or fall back to tiktoken.
  mkdir -p "$HOME/agent_runs"
  ( cd "$_cu_exp" && \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    LITELLM_LOCAL_MODEL_COST_MAP=True \
    PYTHONPATH="$_cu_exp${PYTHONPATH:+:$PYTHONPATH}" \
    nohup "$_cu_litellm" --config "$_cu_yaml" --port "$_cu_port" \
        < /dev/null >> "$_cu_plog" 2>&1 & disown 2>/dev/null )
  for _cu_i in $(seq 60); do
    curl -sf -m 2 "http://127.0.0.1:$_cu_port/health/liveliness" >/dev/null 2>&1 && break
    sleep 2
  done
  if curl -sf -m 2 "http://127.0.0.1:$_cu_port/health/liveliness" >/dev/null 2>&1; then
    echo "Shim    : LiteLLM started on :$_cu_port (log: $_cu_plog)."
  else
    echo "Shim    : FAILED to start. Last lines of $_cu_plog:"
    tail -8 "$_cu_plog" 2>/dev/null | sed 's/^/          /'
    _cu_bad=1
  fi
fi

# Token counting is the check people skip and then misread for months. Claude Code enforces
# its context ceiling against whatever count_tokens returns; if LiteLLM silently fell back
# to tiktoken, an 88k ceiling can be 131k real tokens and the server 400s near the top.
#
# It is checked against vLLM's own /tokenize rather than a remembered magic number, so the
# check calibrates itself and cannot rot when a chat template changes: the two numbers are
# never identical (they wrap the message differently) but they track each other to well
# under a percent when the same tokenizer is behind both.
if curl -sf -m 3 "http://127.0.0.1:$_cu_port/health/liveliness" >/dev/null 2>&1; then
  _cu_ct="$(python3 - "$_cu_port" <<'PY'
import json, sys, urllib.request

port = sys.argv[1]
opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def post(url, body, headers):
    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers)
    return json.load(opener.open(req, timeout=120))


# A numeric table, because that is where tiktoken and Qwen diverge most -- about 49%,
# against ~10% on prose -- and where these runs' context actually goes: score ledgers and
# benchmark output. A short string would not separate the two tokenizers at all.
text = " ".join("%d.%04d" % (i, i * 7 % 9999) for i in range(400))
try:
    ref = post("http://127.0.0.1:9001/tokenize",
               {"model": "Qwen/Qwen3.6-27B-FP8",
                "messages": [{"role": "user", "content": text}]},
               {"content-type": "application/json"})["count"]
    got = post("http://127.0.0.1:%s/v1/messages/count_tokens" % port,
               {"model": "qwen3.6-27b", "messages": [{"role": "user", "content": text}]},
               {"content-type": "application/json", "x-api-key": "sk-local",
                "anthropic-version": "2023-06-01"})["input_tokens"]
    print("%d %d" % (ref, got))
except Exception as exc:                       # a failed probe is a failed check, not a crash
    print("ERR %s" % str(exc)[:120])
PY
)"
  _cu_ref="${_cu_ct%% *}"; _cu_got="${_cu_ct##* }"
  if [ "$_cu_ref" = "ERR" ] || [ -z "$_cu_got" ]; then
    echo "Counting: could not be checked -- $_cu_got"
    echo "          Claude Code's context ceiling is enforced against count_tokens, so this"
    echo "          is not cosmetic. See $_cu_plog."
    _cu_bad=1
  elif [ "$(awk -v a="$_cu_ref" -v b="$_cu_got" 'BEGIN{d=(a-b)/a; print (d<0.05 && d>-0.05)?1:0}')" = "1" ]; then
    echo "Counting: Qwen's tokenizer -- $_cu_got tokens against vLLM's own $_cu_ref. Correct."
  else
    echo "Counting: WRONG -- LiteLLM counts $_cu_got tokens where vLLM counts $_cu_ref."
    echo "          That gap is the tiktoken fallback: the custom_tokenizer did not load, and"
    echo "          Claude Code's context ceiling becomes fiction (a nominal 110k can be past"
    echo "          the server's 130k --max-model-len). Check $_cu_plog for an HF cache miss;"
    echo "          the tokenizer must be in \$HF_HOME/hub/models--Qwen--Qwen3.6-27B-FP8."
    _cu_bad=1
  fi

  # The one check that exercises the whole chain the agent will use: Anthropic Messages in,
  # a tool definition in Anthropic's schema, an OpenAI tool call out of vLLM and an
  # Anthropic tool_use block back. Everything upstream of here can be healthy and this can
  # still fail, because this is the only part that is a translation.
  _cu_msg="$(curl -sS -m 240 "http://127.0.0.1:$_cu_port/v1/messages" \
      -H 'x-api-key: sk-local' -H 'anthropic-version: 2023-06-01' \
      -H 'content-type: application/json' \
      -d '{"model":"qwen3.6-27b","max_tokens":1024,
           "messages":[{"role":"user","content":"List the files in /tmp using the bash tool."}],
           "tools":[{"name":"bash","description":"run a shell command",
                     "input_schema":{"type":"object","properties":{"cmd":{"type":"string"}},
                                     "required":["cmd"]}}]}' 2>&1)"
  case "$_cu_msg" in
    *'"type":"tool_use"'*|*'"type": "tool_use"'*)
      echo "Round   : /v1/messages answered with a tool_use block. The translation works." ;;
    *'"stop_reason"'*)
      echo "Round   : /v1/messages answered, but with no tool call -- it spent its 1024 tokens"
      echo "          thinking. The translation works; the relay already verified tool calling"
      echo "          upstream, so this is not a blocker." ;;
    *)
      echo "Round   : /v1/messages FAILED. Reply was:"
      printf '          %.300s\n' "$_cu_msg"
      _cu_bad=1 ;;
  esac
fi

# --- 5. this shell --------------------------------------------------------------------
# Setting a credential variable replaces the claude.ai login for the session: no
# subscription is consumed and no login is needed, because the token is checked by LiteLLM
# and never leaves this node.
export ANTHROPIC_BASE_URL="http://127.0.0.1:$_cu_port"
export ANTHROPIC_AUTH_TOKEN=sk-local

# Every slot points at the same server. HAIKU/SMALL_FAST are what Claude Code uses for its
# own background work (titles, file summaries); left unset it reaches for a model the proxy
# has never heard of.
export ANTHROPIC_MODEL=qwen3.6-27b
export ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3.6-27b
export ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3.6-27b
export ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3.6-27b
export ANTHROPIC_SMALL_FAST_MODEL=qwen3.6-27b

# Claude Code sends its full Anthropic capability set to any ANTHROPIC_BASE_URL gateway; a
# non-Anthropic upstream 400s on the body fields those betas carry.
export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DISABLE_TELEMETRY=1
export DISABLE_ERROR_REPORTING=1
export DISABLE_AUTOUPDATER=1

# Only controls what Claude Code *asks* for; drop_params discards the ask before vLLM sees
# it, so Qwen's actual thinking stays unconstrained. Without this, an unrecognised model ID
# makes Claude Code send thinking:{"type":"adaptive"}, get rejected, and retry -- one wasted
# request per conversation.
export MAX_THINKING_TOKENS=0

# --- the two parity numbers -----------------------------------------------------------
# 110000 mirrors compaction.context_limit in the bnbcode arm's opencode.json. The semantics
# are not identical and it would be wrong to claim they are: bnbcode compacts when the
# session passes its limit, while Claude Code treats this as the model's whole window and
# compacts against an autocompact buffer below it. Equal ceiling, earlier compaction here.
export CLAUDE_CODE_MAX_CONTEXT_TOKENS=110000
# 16384, not the 32000 the bnbcode arm declares: prompt + max_tokens must stay under vLLM's
# --max-model-len (130000). See litellm_claude.yaml.
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=16384

# The proxy variables are set cluster-wide and no_proxy here is `rng-dl01-*,localhost,
# 127.0.0.1` -- which already covers the shim. Belt and braces, since a missing entry shows
# up as a Bosch HTML error page rather than a connection failure.
export no_proxy="${no_proxy:+$no_proxy,}127.0.0.1,localhost"
export NO_PROXY="$no_proxy"

# HF must resolve the tokenizer from the shared cache, not the hub.
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

# NOT exported: CLAUDE_CONFIG_DIR. It is per run folder, so that one run cannot inherit
# another's history, and the recipe below sets it after the cd.

# --- what now -------------------------------------------------------------------------
printf '\n'
if [ "$_cu_bad" -eq 0 ]; then
  echo "Ready. To start a Claude Code run on this node:"
  echo
  echo "    E=$_cu_exp"
  echo '    P=AC1; V=evo                       # AC1|AC2|Erdos  x  plain|evo'
  echo '    RUN=~/agent_runs/$(echo $P | tr A-Z a-z)_${V}_cc_s1'
  echo '    mkdir -p $RUN && cd $RUN'
  echo '    cp $E/$P/eval.py $E/$P/*.npy .'
  echo '    cp $E/$P/prompt_${V}.md INITIAL_PROMPT.md'
  echo '    export CLAUDE_CONFIG_DIR=$PWD/.cc'
  echo "    claude --settings \$E/claude_guard.json \"\$(cat INITIAL_PROMPT.md)\""
  echo
  echo "The _cc in the folder name is what keeps the two harnesses' runs apart."
  echo "No opencode.json is copied: this arm's configuration is claude_guard.json, which"
  echo "stays outside the run folder where the agent cannot edit it."
  echo
  echo "Headless instead, if you would rather not sit in the session:"
  echo "    claude --settings \$E/claude_guard.json --output-format stream-json --verbose \\"
  echo "           -p \"\$(cat INITIAL_PROMPT.md)\" 2>&1 | tee -a agent.jsonl"
else
  echo "Not ready -- fix what is flagged above, then 'source ~/bin/claude-up' again."
fi
printf '\n'

unset _cu_exp _cu_yaml _cu_guard _cu_relay_url _cu_jobs _cu_port _cu_litellm _cu_host \
      _cu_log _cu_plog _cu_bad _cu_cores _cu_job _cu_models _cu_up _cu_base _cu_i \
      _cu_ct _cu_ref _cu_got _cu_msg
