# LiteLLM proxy for the Claude Code arm on rng-dl01: Anthropic Messages in, OpenAI out.
#
# Claude Code with ANTHROPIC_BASE_URL speaks the Anthropic Messages format only --
# POST /v1/messages (streaming SSE) and /v1/messages/count_tokens. vLLM speaks OpenAI.
# This file is the whole translation layer. bnbcode needs no such thing: it is an
# OpenAI-native client, which is why the Claude arm has one more hop than the bnbcode arm.
#
#   ~/venvs/ccproxy/bin/litellm --config litellm_claude.yaml --port 4000
#
# ~/bin/claude-up starts it for you and checks it end to end. Read that file first.
#
# Sibling configs, and why this is a third one rather than an edit of either:
#   local_model/litellm_qwen.yaml         guadiana, non-FP8 checkpoint, direct 127.0.0.1:8001
#   local_model/litellm_qwen_marvin.yaml  Marvin, api_base from $VLLM_URL (llmtun tunnel)
#   this file                             rng-dl01, api_base fixed at the llm_relay.py relay
#
# model_name is the string Claude Code sends (ANTHROPIC_MODEL, exported by claude-up).
# litellm_params.model must match vLLM's --served-model-name, prefixed hosted_vllm/.
model_list:
  - model_name: qwen3.6-27b
    litellm_params:
      model: hosted_vllm/Qwen/Qwen3.6-27B-FP8

      # The relay, not a GPU node IP. Same process the bnbcode arm points at
      # (~/.config/opencode/opencode.jsonc baseURL), started by agent-up or claude-up,
      # whichever ran first on this node. It re-resolves the LSF job per connection, so a
      # server that moves costs one failed request instead of the session. Because it is a
      # byte pipe it does not care that what flows over it is now OpenAI-from-LiteLLM
      # rather than OpenAI-from-bnbcode.
      api_base: http://127.0.0.1:9001/v1
      api_key: none

      # Parity with the bnbcode arm's opencode.json (agent.build.temperature / top_p).
      # These are DEFAULTS: LiteLLM lets a request override them, and Claude Code does send
      # its own temperature. cc_sampling_hook.py is what actually pins them -- see below.
      temperature: 0.6
      top_p: 0.95

      # Ceiling on a single response. 16384 rather than the 32000 the bnbcode arm declares:
      # vLLM rejects a request whose prompt + max_tokens exceeds --max-model-len (130000
      # here), so with the 110000-token context ceiling this arm runs at, 32000 would start
      # returning hard 400s once a session got long. 110000 + 16384 = 126384 stays under.
      # (The bnbcode arm has the same arithmetic problem and has not hit it yet -- noted in
      # OPERATOR_NOTES.md rather than changed under a running experiment.)
      max_tokens: 16384

      # Reasoning is deliberately UNCONSTRAINED, as in the sibling configs: the model is
      # agentic and decides when to stop thinking. To cap it, and only then:
      #   extra_body: {thinking_token_budget: 11000}   (needs --reasoning-parser on vLLM)
    model_info:
      # WITHOUT THIS, Claude Code's context accounting is fiction. Its window ceiling is
      # enforced against whatever /v1/messages/count_tokens returns, and LiteLLM defaults to
      # tiktoken for a non-Anthropic model -- measured ~10% undercount on prose and code,
      # ~49% on numeric tables, which is exactly what these runs' context fills with.
      #
      # The tokenizer comes from the shared HF cache
      # ($HF_HOME=/fs/scratch/.../vicruz/models/hf, already holding
      # models--Qwen--Qwen3.6-27B-FP8), and claude-up exports HF_HUB_OFFLINE=1 so a compute
      # node never reaches for the hub. Probe: claude-up's count_tokens check.
      #
      # `auth_token: null` is REQUIRED even though the value is never used, and it is not
      # tidy-up-able. LiteLLM 1.97 reads custom_tokenizer["auth_token"] with a plain
      # subscript, so dropping the key turns every count_tokens call into a 500 with
      # KeyError: 'auth_token'. Keeping it makes the proxy log one red line per call --
      #   Error creating pretrained tokenizer: Tokenizer.from_pretrained() got an
      #   unexpected keyword argument 'auth_token'. Defaulting to version without ...
      # -- and then work correctly. That line is EXPECTED. Verified both ways 2026-08-30:
      # with the key, counts land within 0.1% of vLLM's own tokenizer; without it, 500.
      custom_tokenizer:
        identifier: Qwen/Qwen3.6-27B-FP8
        revision: main
        auth_token: null

litellm_settings:
  # Claude Code sends Anthropic-only fields (cache_control, thinking, output_config).
  # Drop them instead of forwarding garbage to vLLM.
  drop_params: true

  # Pins temperature/top_p on every request regardless of what Claude Code asks for, which
  # is the only way to hold sampling equal with the bnbcode arm -- Claude Code has no knob
  # for either. Resolved as <module>.<attribute>; claude-up runs LiteLLM with this
  # directory on PYTHONPATH so the import works.
  callbacks: cc_sampling_hook.handler

general_settings:
  master_key: sk-local
