# LiteLLM shim for the Claude Code arm against Qwen3.8 (cell D).
# Same translation layer as litellm_claude.yaml; only the upstream and model differ:
# api_base is the :9003 relay, which is pinned to gpu6 (the only tool-capable 3.8 server).
model_list:
  - model_name: qwen3.8
    litellm_params:
      model: hosted_vllm/Qwen/Qwen3.8-27B-FP8
      api_base: http://127.0.0.1:9003/v1
      api_key: none
      max_tokens: 16384
      temperature: 0.6
      top_p: 0.95
    model_info:
      # auth_token is required even though unused: LiteLLM 1.97 subscripts the key, and
      # removing it turns every count_tokens call into a 500. It logs one red line per
      # call and then works. See agent_continuity_report/REPORT.md.
      custom_tokenizer:
        identifier: Qwen/Qwen3.8-27B-FP8
        revision: main
        auth_token: null
litellm_settings:
  drop_params: true
  callbacks: cc_sampling_hook.handler
general_settings:
  master_key: sk-local
