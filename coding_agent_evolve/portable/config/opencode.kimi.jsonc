{
  // Global bnbcode/opencode config for the Kimi arm. Goes at ~/.config/opencode/opencode.jsonc.
  //
  // THE ONE TRAP THAT COST THIS CAMPAIGN A PILOT: `temperature` here is a boolean CAPABILITY
  // flag, not a value. src/session/llm/request.ts gates the sampling parameter on it:
  //
  //     temperature: input.model.capabilities.temperature ? (input.agent.temperature ?? ...) : undefined
  //
  // A custom provider that does not declare `"temperature": true` silently sends NO temperature
  // at all, whatever `agent.build.temperature` says -- the run then samples at the server's
  // default and the "temperature 0.6" in your writeup is fiction. Same for `tool_call`, without
  // which the model is never offered tools. Verify on the wire before trusting it; see README.
  //
  // `limit.output` is additionally clamped against a hardcoded OUTPUT_TOKEN_MAX = 32_000 in
  // transform.ts. To go above 32000 you must ALSO set
  // OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=<n> in the environment.

  "provider": {
    "kimi": {
      "name": "Moonshot Kimi",
      "options": {
        // VERIFY against your key's region before the first run: the international endpoint
        // is api.moonshot.ai, the mainland-China one api.moonshot.cn. A key issued for one
        // will 401 against the other.
        "baseURL": "https://api.moonshot.ai/v1",
        "apiKey": "{env:KIMI_API_KEY}"
      },
      "models": {
        "kimi-k2-thinking": {
          "name": "Kimi K2 (thinking)",
          "temperature": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            // Set these to what the model card actually says. Compaction is configured
            // separately, per run, in opencode_run.json (context_limit 160000) -- keep
            // context_limit + output below this context number or you will compact into
            // an overflow.
            "context": 262144,
            "output": 32000
          }
        }
      }
    }
  },

  "model": "kimi/kimi-k2-thinking",

  "agent": {
    "build": { "temperature": 0.6, "top_p": 0.95 },
    "plan":  { "temperature": 0.6, "top_p": 0.95 }
  }
}
