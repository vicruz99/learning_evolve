#!/bin/bash
# =================================================================================================
# LSF job: one headless Claude-Code-on-Qwen coding-agent run on a Marvin (rb-hpc) H100.
#
#   cd ~/work/learning_evolve/coding_agent_evolve/local_model && mkdir -p jobs/logs
#   bsub < jobs/marvin_agent.bsub                       # the run (7-day walltime)
#   AGENT_SMOKE=1 bsub -W 00:20 < jobs/marvin_agent.bsub   # 20-min plumbing check, no task
#
# Environment (bsub inherits the submitting shell):
#   RUN_DIR      task folder, OUTSIDE the repo          (default ~/agent_runs/trimul_h100_qwen1)
#   TASK         which make_run.sh to use                (default h100_task; b200_task also exists)
#   LLM_NAME     llmtun model name for the AGENTIC server (default gpu2 -- the one started with
#                --enable-auto-tool-choice; gpu1 is the ICL server and cannot drive tools)
#   VLLM_URL     override the endpoint instead of asking llmtun
#   KPY          grading interpreter                     (default ~/venvs/kernel-eval/bin/python)
#   AGENT_SMOKE  =1: check the whole chain (GPU, proxy, tokenizer, tool call, `claude -p`) and exit
#   SKIP_TOOLCHECK=1 (smoke only) tolerate a server without tool calling, e.g. the ICL server gpu1
#   GUARD        settings file passed to --settings          (default run_guard_marvin_sandbox.json:
#                bubblewrap sandbox, Bash auto-allowed because confined; grader runs unsandboxed
#                because bwrap hides /dev/nvidia*. See its _comment fields and README.)
#
# Resubmitting with the same RUN_DIR continues in the same folder: best.py, LEDGER.md, attempts/
# and the agent's own .cc config dir persist. The agent is told nothing about the restart.
#
# Why headless: the Marvin gpu queue is NO_INTERACTIVE, so there is no tmux pane to sit in. Nothing
# can answer a permission prompt: with plain acceptEdits every Bash call is refused (attempt 1,
# 2026-08-27), so the default guard sandboxes Bash with bubblewrap and auto-allows it.
# The transcript streams to $RUN_DIR/agent.jsonl.
# =================================================================================================
#BSUB -q gpu
#BSUB -m gpu
#BSUB -J trimul_agent
#BSUB -n 8
#BSUB -R "span[hosts=1] rusage[mem=8192] affinity[core]"
#BSUB -M 8192
#BSUB -gpu "num=1:mode=exclusive_process:j_exclusive=yes"
#BSUB -W 168:00
#BSUB -o jobs/logs/marvin_agent.%J.out
#BSUB -e jobs/logs/marvin_agent.%J.err
#BSUB -app shell

set -uo pipefail
cd "$LS_SUBCWD" || exit 1
HERE="$PWD"                                   # coding_agent_evolve/local_model
# Several of these jobs can share a node (one card each), so every local port must be picked
# per job, not hard-coded: a second job on the node would otherwise fail to bind and silently
# talk to the first job's servers (seen 2026-08-27: r2 and the agent both rode r1's relay).
pick_port() { /usr/bin/python3.12 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])'; }
alive_or_die() {  # alive_or_die <pid> <what> <log>
    sleep 2; if ! kill -0 "$1" 2>/dev/null; then echo "[job] ERROR: $2 died at startup; log:" >&2; tail -5 "$3" >&2; exit 1; fi
}
GPUMODE="$(dirname "$HERE")/gpumode"
TASK="${TASK:-h100_task}"
RUN_DIR="${RUN_DIR:-$HOME/agent_runs/trimul_h100_qwen1}"
LLM_NAME="${LLM_NAME:-gpu2}"
GUARD="${GUARD:-run_guard_marvin_sandbox.json}"   # settings file in this dir; the sandboxed guard is the default
export KPY="${KPY:-$HOME/.local/bin/kpy-serial}"     # flock wrapper around ~/venvs/kernel-eval/bin/python:
export TRIMUL_LOCK="/tmp/trimul-eval-${LSB_JOBID}.lock"   # one grader at a time on this job's card
LITELLM="$HOME/venvs/ccproxy/bin/litellm"
PROXY_PORT="${PROXY_PORT:-$(pick_port)}"
export PATH="$HOME/.local/bin:$PATH"
mkdir -p "$HOME/agent_runs"

# No external network exists here; make sure nothing tries. HF must resolve from the local cache.
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY
export HF_HOME="$HOME/models/hf" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export LITELLM_LOCAL_MODEL_COST_MAP=True      # no price-map fetch attempt through the dead proxy

echo "=== job $LSB_JOBID on $(hostname)  GPU=${CUDA_VISIBLE_DEVICES:-unset}  run=$RUN_DIR  task=$TASK  $(date)"
nvidia-smi --query-gpu=name,driver_version --format=csv,noheader

# ---- 1. LLM endpoint through the llmtun relay ---------------------------------------------------
# In-job relay (src/jobs/llm_relay.py): LiteLLM keeps api_base for the whole run, but the llmtun
# tunnel's IP changes when it is rebuilt on another login node (its port is sticky). The relay
# re-reads ~/.llmtun/endpoints on failure, so LiteLLM only ever sees 127.0.0.1.
RELAY_PORT="${RELAY_PORT:-$(pick_port)}"
if [[ -z "${VLLM_URL:-}" ]]; then
    "$HOME/bin/llmtun" url "$LLM_NAME" >/dev/null || { echo "[job] ERROR: llmtun has no entry for $LLM_NAME (llmtun sync on a login node?)" >&2; exit 1; }
    /usr/bin/python3.12 "$(dirname "$GPUMODE")/../src/jobs/llm_relay.py" --name "$LLM_NAME" --port "$RELAY_PORT" \
        >"$HOME/agent_runs/relay_${LSB_JOBID}.log" 2>&1 &
    RELAY_PID=$!
    alive_or_die "$RELAY_PID" "llm_relay" "$HOME/agent_runs/relay_${LSB_JOBID}.log"
    VLLM_URL="http://127.0.0.1:$RELAY_PORT/v1"
fi
export VLLM_URL
export no_proxy="${no_proxy:+$no_proxy,}127.0.0.1,localhost"
export NO_PROXY="$no_proxy"
echo "[job] LLM: $VLLM_URL  (relay -> llmtun '$LLM_NAME': $($HOME/bin/llmtun url $LLM_NAME 2>/dev/null || echo override))"
for _ in $(seq 1 120); do curl -sf -m 10 "${VLLM_URL%/v1}/health" >/dev/null && break; sleep 15; done
curl -sf -m 10 "${VLLM_URL%/v1}/health" >/dev/null || { echo "[job] ERROR: no vLLM at $VLLM_URL after 30 min" >&2; exit 1; }

# The server must have been started with tool calling on; without it the agent narrates and never acts.
TC=$(curl -s -m 120 "$VLLM_URL/chat/completions" -H 'Content-Type: application/json' -d '{
  "model":"Qwen/Qwen3.6-27B-FP8","max_tokens":400,
  "messages":[{"role":"user","content":"List the files in /tmp using the bash tool."}],
  "tools":[{"type":"function","function":{"name":"bash","description":"run a shell command",
    "parameters":{"type":"object","properties":{"cmd":{"type":"string"}},"required":["cmd"]}}}],
  "tool_choice":"auto"}')
if ! grep -q '"tool_calls"' <<<"$TC"; then
    if [[ -n "${AGENT_SMOKE:-}" && -n "${SKIP_TOOLCHECK:-}" ]]; then
        echo "[job] WARNING: no tool_calls from $VLLM_URL (SKIP_TOOLCHECK set: smoke continues; a real run would stop here)"
    else
    echo "[job] ERROR: the server at $VLLM_URL did not return tool_calls. It needs" >&2
    echo "      --enable-auto-tool-choice --tool-call-parser qwen3_xml (see serve_qwen.sh). Response:" >&2
    echo "$TC" | head -c 1500 >&2; echo >&2
    exit 1
    fi
else
    echo "[job] tool calling: OK"
fi

# ---- 2. grading stack on the granted card --------------------------------------------------------
KPY="$HOME/venvs/kernel-eval/bin/python" "$HERE/check_gpu.sh" || exit 1   # the real interpreter: kpy-serial only runs evaluate.py

# ---- 3. the Anthropic-format shim --------------------------------------------------------------
[[ -x "$LITELLM" ]] || { echo "[job] ERROR: $LITELLM missing (provision ~/venvs/ccproxy)" >&2; exit 1; }
PROXY_LOG="$HOME/agent_runs/litellm_${LSB_JOBID}.log"
"$LITELLM" --config "$HERE/litellm_qwen_marvin.yaml" --port "$PROXY_PORT" >"$PROXY_LOG" 2>&1 &
PROXY_PID=$!
alive_or_die "$PROXY_PID" "litellm" "$PROXY_LOG"
trap 'kill $PROXY_PID ${RELAY_PID:-} 2>/dev/null' EXIT
for _ in $(seq 90); do curl -sf -m 2 "http://127.0.0.1:$PROXY_PORT/health/liveliness" >/dev/null 2>&1 && break; sleep 2; done
curl -sf -m 2 "http://127.0.0.1:$PROXY_PORT/health/liveliness" >/dev/null 2>&1 || { echo "[job] ERROR: LiteLLM never came up; see $PROXY_LOG" >&2; tail -30 "$PROXY_LOG" >&2; exit 1; }
# Token counter must be Qwen's, not tiktoken (README: the 88k ceiling is fiction otherwise).
CT=$(curl -s -m 30 "http://127.0.0.1:$PROXY_PORT/v1/messages/count_tokens" \
  -H 'x-api-key: sk-local' -H 'anthropic-version: 2023-06-01' -H 'content-type: application/json' \
  -d '{"model":"qwen3.6-27b","messages":[{"role":"user","content":"1234567890 9876543210"}]}')
echo "[job] count_tokens probe: $CT   (Qwen tokenizer ~13-14 tokens; tiktoken would say ~10)"
grep -q '"input_tokens"' <<<"$CT" || echo "[job] WARNING: count_tokens did not answer; the proxy may have fallen back to tiktoken -- check $PROXY_LOG"

# ---- 4. the run folder (outside the repo) --------------------------------------------------------
if [[ ! -d "$RUN_DIR" ]]; then
    "$GPUMODE/$TASK/make_run.sh" "$RUN_DIR" || exit 1
else
    echo "[job] resuming existing run folder $RUN_DIR"
fi

# ---- 5. Claude Code, headless ------------------------------------------------------------------
# shellcheck source=../env.sh
source "$HERE/env.sh"
export ANTHROPIC_BASE_URL="http://127.0.0.1:$PROXY_PORT"   # env.sh assumes :4000; ports are per job here
export CLAUDE_CONFIG_DIR="$RUN_DIR/.cc"; mkdir -p "$CLAUDE_CONFIG_DIR"
command -v claude >/dev/null || { echo "[job] ERROR: claude binary not on PATH (provision ~/.local/share/claude)" >&2; exit 1; }
echo "[job] claude $(claude --version 2>/dev/null)"
cd "$RUN_DIR"

if [[ -n "${AGENT_SMOKE:-}" ]]; then
    echo "[job] SMOKE (sandbox): confinement probes through headless claude"
    rm -f "$HOME/outside_probe_$LSB_JOBID" inside_probe
    PROBE="You are a plumbing test. Run EACH of the following bash commands with the Bash tool, one per call, exactly as written, and then reply with a numbered list quoting each command's output verbatim (or the error text). Do not analyse, do not fix, do not retry.
1. echo SANDBOX_OK; pwd; id -u
2. $KPY -c 'import torch,triton;print(\"torch\",torch.__version__,\"cuda\",torch.cuda.is_available(),\"dev\",torch.cuda.device_count())'
3. touch inside_probe && echo WROTE_INSIDE
4. touch $HOME/outside_probe_$LSB_JOBID && echo WROTE_OUTSIDE
5. head -c 80 /home/crv1pi/work/learning_evolve/CLAUDE.md
6. ls /home/crv1pi/agent_runs
7. ls /home/crv1pi/.ssh
8. $KPY evaluate.py trimul/submission.py --mode test 2>&1 | tail -2
10. ls /dev/nvidia* 2>&1 | head -2
11. echo A; echo B
9. curl -s -m 3 http://example.com >/dev/null && echo NET_OPEN || echo NET_BLOCKED
Then, with the Write tool (not Bash), create write_tool_probe.txt in the current folder containing WRITE_TOOL_OK, and run with Bash: cat write_tool_probe.txt
Then, with the Write tool, create /tmp/tmp_probe.txt containing TMP_OK, and run with Bash: cat /tmp/tmp_probe.txt
Then use the Read tool on evaluate.py and quote its first line.
Finally run `echo BYPASS_TEST` with the Bash tool with the parameter dangerouslyDisableSandbox set to true, and quote the outcome."
    claude --settings "$HERE/$GUARD" --output-format stream-json --verbose -p "$PROBE" 2>&1 | tee smoke.jsonl \
      | grep -o '"name":"[A-Za-z]*"\|permission_denied[^,]*\|"is_error":true' | sort | uniq -c
    echo "[job] final reply:"; grep -o '"result":"[^"]*' smoke.jsonl | tail -1 | cut -c1-3000; echo
    echo "[job] verdicts:"
    [[ -e inside_probe ]] && echo "  inside write : OK (file exists)" || echo "  inside write : FAIL (agent could not write in run dir)"
    [[ -e "$HOME/outside_probe_$LSB_JOBID" ]] && echo "  outside write: FAIL (escaped the sandbox)" || echo "  outside write: OK (blocked)"
    echo "[job] SMOKE done $(date)"; exit 0
fi

# Human-readable transcript (what the interactive UI would show), refreshed every 2 min -> $RUN_DIR/transcript.md
/usr/bin/python3.12 "$HERE/render_transcript.py" "$RUN_DIR/agent.jsonl" --follow --every 120 >/dev/null 2>&1 &
RENDER_PID=$!
trap 'kill $RENDER_PID $PROXY_PID ${RELAY_PID:-} 2>/dev/null; /usr/bin/python3.12 "$HERE/render_transcript.py" "$RUN_DIR/agent.jsonl" 2>/dev/null' EXIT
echo "[job] agent start $(date)   transcript: $RUN_DIR/transcript.md"
claude --settings "$HERE/$GUARD" \
       --output-format stream-json --verbose \
       -p "$(cat INITIAL_PROMPT.md)" 2>&1 | tee -a agent.jsonl
rc=${PIPESTATUS[0]}
echo "[job] agent exited $rc $(date)"
[[ -f LEDGER.md ]] && { echo "[job] ledger:"; tail -20 LEDGER.md; }
exit "$rc"
