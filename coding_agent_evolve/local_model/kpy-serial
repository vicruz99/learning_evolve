#!/bin/bash
# $KPY for coding-agent runs (installed as ~/.local/bin/kpy-serial; source of truth in
# coding_agent_evolve/local_model/kpy-serial).
#
# It is the ONLY command the sandboxed agent may run unsandboxed (sandbox.excludedCommands),
# because bubblewrap hides /dev/nvidia*. Two jobs, both enforced here rather than trusted:
#   1. one grader at a time on the job's single GPU: exclusive flock (TRIMUL_LOCK, per job);
#   2. it runs evaluate.py and nothing else -- otherwise `$KPY -c ...` is a general unsandboxed
#      interpreter that can read the whole filesystem (seen 2026-08-27: the agent used it to
#      read and write files after sandbox flakes).
LOCK="${TRIMUL_LOCK:-/tmp/trimul-eval-${LSB_JOBID:-nojob}.lock}"
PY=/home/crv1pi/venvs/kernel-eval/bin/python

case "${1:-}" in
    evaluate.py|./evaluate.py|*/evaluate.py) ;;
    *)
        echo "KPY runs the grader only:  \$KPY evaluate.py <candidate.py> --mode test|leaderboard [...]" >&2
        echo "For anything else use your normal shell and file tools." >&2
        exit 2 ;;
esac
exec flock -w 7200 "$LOCK" "$PY" "$@"
