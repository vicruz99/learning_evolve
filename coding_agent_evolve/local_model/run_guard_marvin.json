{
  "_comment": "Containment guard for local-model agent runs on Marvin (rb-hpc, user crv1pi). Same rules as run_guard.json with the paths rewritten for this machine. Pass with --settings so it stays OUTSIDE the folder the agent can edit. Denies this project's notes about the tasks, the published TTT-Discover solutions, and the auto-memory directories. Web tools are denied because they do not work behind a local model anyway.",
  "permissions": {
    "deny": [
      "WebSearch",
      "WebFetch",
      "Read(//home/crv1pi/work/learning_evolve/discover/**)",
      "Read(//home/crv1pi/work/learning_evolve/coding_agent_evolve/**)",
      "Read(//home/crv1pi/work/learning_evolve/docs/**)",
      "Read(//home/crv1pi/work/learning_evolve/notes/**)",
      "Read(//home/crv1pi/work/learning_evolve/CLAUDE.md)",
      "Read(//home/crv1pi/work/learning_evolve/src/gpumode_local/**)",
      "Read(//home/crv1pi/work/learning_evolve/src/runs/**)",
      "Read(//home/crv1pi/work/learning_evolve/ShinkaEvolve/**)",
      "Read(//home/crv1pi/.claude/projects/**)",
      "Read(//home/crv1pi/.claude-vi/projects/**)",
      "Bash(cat *trimul_best*)",
      "Bash(cp *trimul_best*)",
      "Bash(cat *candidate*)",
      "Bash(cp *candidate*)",
      "Bash(cat */kernel-engineering/*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "autoMemoryEnabled": false,
  "claudeMdExcludes": [
    "**/learning_evolve/CLAUDE.md",
    "**/coding_agent_evolve/**/CLAUDE.md"
  ]
}
