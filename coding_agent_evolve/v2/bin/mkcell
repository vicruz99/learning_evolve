#!/usr/bin/env bash
# mkcell --campaign <name> [--only REGEX] [--set k=v ...] [--seeds 1 2] [--dry] [--force]
# Renders cells from v2/cells.yaml into ~/agent_runs/v2/<campaign>/. See driver/mkcell.py.
set -eu
V2="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "$HOME/venvs/v2-driver/bin/python" "$V2/driver/mkcell.py" "$@"
