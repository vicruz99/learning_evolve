#!/usr/bin/env python3
"""retune_flags CAMPAIGN [--only REGEX] [--guard on|off] [--continual on|off] [--apply]

Flip the bnbcode behaviour flags of cells that are ALREADY rendered, in place, without
touching their run data.  Patches cell.json only:

  bnbcode.continual_work        -> harness_bnbcode.py writes it into OPENCODE_CONFIG_CONTENT
  bnbcode.visible_output_guard  -> BNBCODE_VISIBLE_OUTPUT_GUARD in the agent's env

A cell reads both at launch, so patching a RUNNING cell changes nothing until it is
restarted (bin/restart_cells).  Written 2026-09-09 alongside bin/retune_limits.
"""
import argparse, json, re
from pathlib import Path

RUNS = Path.home() / "agent_runs" / "v2"
FLAG = {"on": True, "off": False}


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("campaign")
    ap.add_argument("--only", default=".*", help="regex on the cell name")
    ap.add_argument("--guard", choices=("on", "off"))
    ap.add_argument("--continual", choices=("on", "off"))
    ap.add_argument("--apply", action="store_true", help="without this, only print what would change")
    a = ap.parse_args()
    if a.guard is None and a.continual is None:
        ap.error("nothing to do: pass --guard and/or --continual")
    rx = re.compile(a.only)
    cells = sorted(p for p in (RUNS / a.campaign).iterdir()
                   if p.is_dir() and (p / "cell.json").exists() and rx.search(p.name))
    n = 0
    for cell in cells:
        cj = cell / "cell.json"
        c = json.loads(cj.read_text())
        b = c.setdefault("bnbcode", {})
        if c.get("harness") != "bnbcode":
            continue
        was = (b.get("continual_work"), b.get("visible_output_guard"))
        if a.continual is not None:
            b["continual_work"] = FLAG[a.continual]
        if a.guard is not None:
            b["visible_output_guard"] = FLAG[a.guard]
        now = (b.get("continual_work"), b.get("visible_output_guard"))
        if a.apply:
            cj.write_text(json.dumps(c, indent=1) + "\n")
        n += 1
        print("%-42s continual_work %s->%s  guard %s->%s" % (cell.name, was[0], now[0], was[1], now[1]))
    print("%d bnbcode cell(s) %s" % (n, "patched" if a.apply else "would be patched (dry run)"))


if __name__ == "__main__":
    main()
