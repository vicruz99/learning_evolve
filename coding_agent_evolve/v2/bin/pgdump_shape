#!/usr/bin/env python3
"""pgdump_shape <pgbackup.sql> -- print "events parts messages": row counts of the bnbcode session
store's event, part and message tables, streamed from a plain pg_dump (COPY blocks). bin/launch uses
the shape -- not the size -- to tell a runaway store from a long conversation before restoring it."""
import sys
n = {}; t = None
with open(sys.argv[1], "rb") as fh:
    for line in fh:
        if t is None:
            if line.startswith(b"COPY public."):
                t = line.split()[1][len(b"public."):].decode(); n[t] = 0
        elif line == b"\\.\n":
            t = None
        else:
            n[t] += 1
print(n.get("event", 0), n.get("part", 0), n.get("message", 0))
