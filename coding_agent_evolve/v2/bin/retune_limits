#!/usr/bin/env python3
"""retune_limits CAMPAIGN --output N --context N --cc-output N --cc-context N [--apply]

Rewrite the token limits of cells that are ALREADY rendered, in place, without touching
their run data (mkcell --force would delete the cell). Patches, per cell:

  cell.json                     bnbcode.output_tokens, claude.max_output_tokens/max_context_tokens
  workspace/opencode.json       provider model limit.output   (chmod 444 -> write -> 444)

Why: an output-token budget that large leaves too little input room under the server's
max-model-len. A single step can then jump from below the compaction point straight past
the ceiling, vLLM answers 400, and the driver has to abandon the conversation. Written
2026-09-09 after three cells did exactly that 50 minutes into the r2 campaign.

A cell only reads these at launch, so patch first and restart the cell afterwards.
"""
import argparse, json, os
from pathlib import Path

RUNS = Path.home() / "agent_runs" / "v2"


def patch_cell(cell: Path, out: int, cc_out: int, cc_ctx: int, apply: bool):
    cj = cell / "cell.json"
    c = json.loads(cj.read_text())
    before = (c.get("bnbcode", {}).get("output_tokens"), c.get("claude", {}).get("max_output_tokens"), c.get("claude", {}).get("max_context_tokens"))
    c.setdefault("bnbcode", {})["output_tokens"] = out
    c.setdefault("claude", {})["max_output_tokens"] = cc_out
    c["claude"]["max_context_tokens"] = cc_ctx
    oc = cell / "workspace" / "opencode.json"
    ocbefore = None
    if oc.exists():
        o = json.loads(oc.read_text())
        for prov in o.get("provider", {}).values():
            for m in prov.get("models", {}).values():
                ocbefore = m.get("limit", {}).get("output")
                m.setdefault("limit", {})["output"] = out
    if apply:
        cj.write_text(json.dumps(c, indent=1) + "\n")
        if oc.exists():
            os.chmod(oc, 0o644)
            oc.write_text(json.dumps(o, indent=2) + "\n")
            os.chmod(oc, 0o444)
    print("%-46s bnb_out %s->%d  cc_out %s->%d  cc_ctx %s->%d  opencode_out %s->%d"
          % (cell.parent.name + "/" + cell.name, before[0], out, before[1], cc_out, before[2], cc_ctx, ocbefore, out))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("campaign")
    ap.add_argument("--output", type=int, required=True, help="bnbcode output_tokens (and opencode limit.output)")
    ap.add_argument("--cc-output", type=int, required=True)
    ap.add_argument("--cc-context", type=int, required=True)
    ap.add_argument("--apply", action="store_true", help="without this, only print what would change")
    a = ap.parse_args()
    cells = sorted(p for p in (RUNS / a.campaign).iterdir() if p.is_dir() and (p / "cell.json").exists())
    for cell in cells:
        patch_cell(cell, a.output, a.cc_output, a.cc_context, a.apply)
    print("%d cell(s) %s" % (len(cells), "patched" if a.apply else "would be patched (dry run)"))


if __name__ == "__main__":
    main()
