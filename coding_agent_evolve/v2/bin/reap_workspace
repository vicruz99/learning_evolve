#!/usr/bin/env python3
"""reap_workspace <cell_dir> [grace_s]

Kill every process of ours whose cwd (or any open-file / exe path) lies under the cell dir --
the agent's background candidates survive the harness being terminated and would otherwise run
on for up to 1100 s each, hogging the cores the host scorer and the next cell need. SIGTERM, wait
grace_s (default 10), then SIGKILL. Prints what it killed. Never touches the driver's own infra
(relay, LiteLLM, postgres live elsewhere)."""
import os, signal, sys, time
from pathlib import Path


def targets(root: str) -> dict:
    me = os.getpid(); uid = os.getuid(); found = {}
    for p in Path("/proc").iterdir():
        if not p.name.isdigit() or int(p.name) == me:
            continue
        try:
            if p.stat().st_uid != uid:
                continue
            cwd = os.readlink(p / "cwd")
        except OSError:
            continue
        if cwd == root or cwd.startswith(root + "/"):
            try:
                cmd = (p / "cmdline").read_bytes().replace(b"\0", b" ").decode("utf-8", "replace")[:160]
            except OSError:
                cmd = "?"
            found[int(p.name)] = cmd
    return found


def main() -> int:
    root = str(Path(sys.argv[1]).resolve())
    grace = float(sys.argv[2]) if len(sys.argv) > 2 else 10.0
    victims = targets(root)
    if not victims:
        print("reap_workspace: nothing running under", root); return 0
    for pid, cmd in victims.items():
        print(f"reap_workspace: TERM {pid} {cmd}")
        try: os.kill(pid, signal.SIGTERM)
        except ProcessLookupError: pass
    deadline = time.time() + grace
    while time.time() < deadline and targets(root):
        time.sleep(0.5)
    for pid, cmd in targets(root).items():
        print(f"reap_workspace: KILL {pid} {cmd}")
        try: os.kill(pid, signal.SIGKILL)
        except ProcessLookupError: pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
