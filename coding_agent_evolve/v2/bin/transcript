#!/usr/bin/env python3
"""transcript <cell_dir> [-f] [--thoughts] [--tail N]

Render a cell's events.jsonl (bnbcode ACP stream or Claude Code stream-json) as a readable
transcript: model text, tool calls, host nudges, driver decisions. -f follows the file like
tail -f. --thoughts also prints reasoning. Works while the cell is running."""
import argparse, json, sys, time
from pathlib import Path

def fmt_t(t): return time.strftime("%H:%M:%S", time.localtime(t))

class R:
    def __init__(self, thoughts): self.th = thoughts; self.buf = []; self.thbuf = []; self.tools = {}
    def flush(self):
        if self.buf: print("".join(self.buf).strip()); print(); self.buf = []
        if self.thbuf:
            if self.th: print("  [thinking] " + "".join(self.thbuf).strip().replace("\n", "\n  ")); print()
            self.thbuf = []
    def line(self, e):
        k = e.get("kind"); t = fmt_t(e.get("t", 0))
        if k == "acp":
            u = e.get("update")
            if u == "agent_message_chunk": self.buf.append(e.get("text", "")); return
            if u == "agent_thought_chunk": self.thbuf.append(e.get("thought", "")); return
            if e.get("tool_call_id"):
                st = e.get("status"); tid = e["tool_call_id"]
                if st in ("pending", "in_progress") and tid not in self.tools:
                    self.tools[tid] = 1; self.flush(); print(f"{t} >> tool {e.get('title')}")
                elif st in ("completed", "failed"): self.flush(); print(f"{t} << {st} {e.get('title')}")
            return
        if k == "cc":
            typ = e.get("type"); p = e.get("payload") or {}
            if typ == "assistant":
                for b in (p.get("message") or {}).get("content") or []:
                    if b.get("type") == "text" and b.get("text", "").strip(): self.flush(); print(f"{t} {b['text'].strip()}\n")
                    elif b.get("type") == "thinking" and self.th: print(f"  [thinking] {b.get('thinking','')[:2000]}\n")
                    elif b.get("type") == "tool_use":
                        inp = json.dumps(b.get("input", {}))[:300]; print(f"{t} >> tool {b.get('name')} {inp}")
            elif typ == "user":
                for b in (p.get("message") or {}).get("content") or []:
                    if isinstance(b, dict) and b.get("type") == "tool_result":
                        c = b.get("content"); s = c if isinstance(c, str) else json.dumps(c)
                        print(f"{t} << result {s[:200].replace(chr(10), ' ')}{'...' if len(s) > 200 else ''}")
            elif typ == "result": print(f"{t} == turn result: {p.get('subtype')} turns={p.get('num_turns')}")
            return
        self.flush()
        if k == "prompt": print(f"{t} ###### HOST PROMPT ({e.get('chars')} chars): {e.get('head','')[:160]!r}\n")
        elif k == "turn_end": print(f"{t} ====== TURN END stop={e.get('stop_reason')} ran={e.get('ran_s',0):.0f}s tools={e.get('tools')}")
        elif k == "decision": print(f"{t} ====== HOST DECISION: {'CONTINUE' if e.get('go') else 'END'} ({e.get('why')}) evals={e.get('evals')}")
        elif k == "session_start": print(f"{t} ====== SESSION #{e.get('session_no')} {e.get('session_id','')}")
        elif k in ("infra", "stall_retry", "throttle"): print(f"{t} ====== {k}: {json.dumps({x: y for x, y in e.items() if x not in ('t', 'kind')})[:300]}")

def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cell", type=Path); ap.add_argument("-f", action="store_true"); ap.add_argument("--thoughts", action="store_true")
    ap.add_argument("--tail", type=int, default=0, help="start from the last N events")
    a = ap.parse_args(); path = a.cell / "events.jsonl"; r = R(a.thoughts)
    with open(path) as fh:
        lines = fh.readlines()
        for ln in (lines[-a.tail:] if a.tail else lines):
            try: r.line(json.loads(ln))
            except ValueError: pass
        r.flush()
        while a.f:
            ln = fh.readline()
            if not ln: r.flush(); time.sleep(0.5); continue
            try: r.line(json.loads(ln))
            except ValueError: pass
            sys.stdout.flush()

if __name__ == "__main__":
    main()
