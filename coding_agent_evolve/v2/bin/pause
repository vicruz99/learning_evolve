#!/usr/bin/env bash
# pause <campaign|cell_dir> on|off|status  -- operator pause of running cells (2026-09-21).
# `on` touches <cell>/PAUSE: within a minute the driver stops the harness cleanly, stops the budget clock and waits
# inside the LSF job; `off` removes the file and the run resumes with its conversation restored once the relay has
# a live upstream. The same path fires automatically when the LLM upstream is gone for 5 min. Use it before
# planned maintenance (server restart, node work); never for agent-side problems.
set -u
T=${1:?usage: pause <campaign|cell_dir> on|off|status}; A=${2:-status}
if [ -d "$T" ] && [ -f "$T/cell.json" ]; then CELLS=("$T"); else CELLS=("$HOME"/agent_runs/v2/"$T"/*/); fi
for D in "${CELLS[@]}"; do
  D=${D%/}; [ -f "$D/cell.json" ] || continue
  case "$A" in
    on)  touch "$D/PAUSE" && echo "PAUSE set   $(basename "$D")";;
    off) rm -f "$D/PAUSE" && echo "PAUSE clear $(basename "$D")";;
    status) printf '%-40s %s  %s\n' "$(basename "$D")" "$([ -f "$D/PAUSE" ] && echo PAUSE-FILE || echo -)" \
              "$(python3 -c "import json,sys; c=json.load(open('$D/clock.json')); print('paused' if c.get('paused_now') else 'running', round(c.get('active_s',0)/3600,2),'h active', round(c.get('paused_s',0)/3600,2),'h paused')" 2>/dev/null)";;
    *) echo "unknown action $A" >&2; exit 1;;
  esac
done
