#!/usr/bin/env bash
# restart_cells <campaign> [--only REGEX] [--yes]
#
# Stop the RUNNING cells of a campaign and submit them again. A restart is a resume: the
# clock keeps the time already spent (clock.json), the tracker keeps every official score,
# the workspace keeps every file, Claude Code continues its transcript, and bnbcode's
# session database is restored from the cell's pgbackup.sql. What is lost is whatever was
# being evaluated at the moment of the kill, and up to two minutes of bnbcode conversation.
#
# Use it after changing something a cell only reads at launch, e.g. bin/retune_limits.
# PENDING cells are left alone: they have not started, so they pick up the new files anyway.
set -euo pipefail
CAMP=${1:?usage: restart_cells <campaign> [--only REGEX] [--yes]}; shift
ONLY=""; YES=0
while [ $# -gt 0 ]; do case "$1" in --only) ONLY="$2"; shift 2;; --yes) YES=1; shift;; *) echo "unknown arg $1" >&2; exit 1;; esac; done
V2="$(cd "$(dirname "$0")/.." && pwd)"

JOBS=$(bjobs -w -noheader 2>/dev/null | awk -v c="$CAMP" '$3=="RUN" && $7 ~ "^"c"\\." {print $1, $7}' || true)
[ -n "$ONLY" ] && JOBS=$(printf '%s\n' "$JOBS" | grep -E "$ONLY" || true)
[ -z "$JOBS" ] && { echo "no running cells in $CAMP"; exit 0; }

echo "$JOBS" | sed 's/^/  /'
N=$(printf '%s\n' "$JOBS" | wc -l)
if [ "$YES" != "1" ]; then echo "would restart $N cell(s); add --yes to do it"; exit 0; fi

printf '%s\n' "$JOBS" | while read -r id name; do bkill "$id" >/dev/null 2>&1 || true; echo "killed $name ($id)"; done
for i in $(seq 1 30); do
  left=$(bjobs -w -noheader 2>/dev/null | awk -v c="$CAMP" '$7 ~ "^"c"\\." {print}' | grep -c RUN || true)
  [ "$left" = "0" ] && break
  sleep 10
done
sleep 5
"$V2/bin/submit" "$CAMP" ${ONLY:+--only "$ONLY"}
