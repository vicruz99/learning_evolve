#!/usr/bin/env bash
# submit_marvin <campaign> [--only REGEX] [--dry]  -- one subbin job per cell, for cells rendered with `site: marvin`.
# Marvin (rb-hpc) wraps LSF in subbin: whole AMD nodes (64 cores, SMT off), `small` queue (walltime up to 17 d),
# --localdisk so the per-cell postgres and the agent's /tmp land on the node's SSD. The job runs bin/launch, which
# is site-agnostic (relay discovery by LSF job name works on Marvin too; fixed host:port tokens are the fallback).
set -u
CAMP=${1:?usage: submit_marvin <campaign> [--only REGEX] [--dry] [--queue Q]}; shift
ONLY=".*"; DRY=""; QUEUE="small"
while [ $# -gt 0 ]; do case "$1" in --only) ONLY="$2"; shift 2;; --dry) DRY=1; shift;; --queue) QUEUE="$2"; shift 2;; *) echo "unknown arg $1" >&2; exit 1;; esac; done
V2="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$HOME/venvs/v2-driver/bin/python"
ROOT="$HOME/agent_runs/v2/$CAMP"
[ -d "$ROOT" ] || { echo "no such campaign dir: $ROOT" >&2; exit 1; }
n=0
for D in "$ROOT"/*/; do
  D=${D%/}; NAME=$(basename "$D")
  [ -f "$D/cell.json" ] || continue
  echo "$NAME" | grep -Eq "$ONLY" || continue
  read -r CORES HOURS EXTRA SITE HOSTT <<<"$("$PY" -c "import json; c=json.load(open('$D/cell.json')); print(c['cores'], c['hours'], c.get('wall_extra_h', 4), c.get('site','rngdl01'), c.get('host_type','amd'))")"
  [ "$SITE" = marvin ] || { echo "skip (site=$SITE, use bin/submit): $NAME"; continue; }
  # walltime = budget + wall_extra_h: a paused run (LLM outage) waits INSIDE the job, so give it room (48 h budget -> 72 h)
  WALL=$("$PY" -c "import math; print(math.ceil(float('$HOURS') + float('$EXTRA')))")
  if bjobs -J "$CAMP.$NAME" 2>&1 | grep -qv "is not found"; then echo "skip (in LSF): $NAME"; continue; fi
  { echo '#!/bin/bash'; echo "# generated by bin/submit_marvin $(date +%F_%T)"; echo "CELL_DIR='$D'"; echo "V2DIR='$V2'"
    cat <<'SH'
# subbin's small/short wrapper exports OMP_NUM_THREADS=1, which makes `nproc` answer 1 inside the job (Marvin
# CLAUDE.md section 6). The prompt tells the agent that nproc reports its cores and its candidates pin their own
# threads, so drop the wrapper's pin; nproc then reports the affinity mask, i.e. the allocation.
unset OMP_NUM_THREADS MKL_NUM_THREADS OPENBLAS_NUM_THREADS NUMEXPR_NUM_THREADS
echo "[marvin_job $(date +%H:%M:%S)] host=$(hostname) nproc=$(nproc) LSB_DJOB_NUMPROC=${LSB_DJOB_NUMPROC:-?} tmp: $(df -h /tmp | tail -1)" >> "$CELL_DIR/driver.log"
exec "$V2DIR/bin/launch" "$CELL_DIR" >> "$CELL_DIR/lsf.out" 2>> "$CELL_DIR/lsf.err"
SH
  } > "$D/marvin_job.sh"
  chmod +x "$D/marvin_job.sh"
  CMD=(subbin -q "$QUEUE" -h "$HOSTT" -n "$CORES" -r "$WALL" -M NOMPI --localdisk --autorestart=no
       -j "$CAMP.$NAME" --stdout="$D/subbin.out" -z "$D" "$D/marvin_job.sh")
  if [ -n "$DRY" ]; then
    echo "${CMD[*]}"; (cd "$D" && subbin -x -k -q "$QUEUE" -h "$HOSTT" -n "$CORES" -r "$WALL" -M NOMPI --localdisk --autorestart=no -j "$CAMP.$NAME" --stdout="$D/subbin.out" -z "$D" "$D/marvin_job.sh" 2>&1 | tail -3)
  else
    (cd "$D" && "${CMD[@]}") && echo "submitted $NAME (${CORES} cores, ${WALL} h, $HOSTT, $QUEUE)" || echo "FAILED $NAME"
  fi
  n=$((n+1))
done
echo "--- $n cell(s) in $CAMP ---"
