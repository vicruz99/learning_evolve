#!/usr/bin/env bash
# status <campaign> -- LSF state, official evals, best score and last activity per cell
set -u
CAMP=${1:?usage: status <campaign>}
exec "$HOME/venvs/v2-driver/bin/python" - "$HOME/agent_runs/v2/$CAMP" "$CAMP" <<'PY'
import json, os, subprocess, sys, time
from pathlib import Path
root, camp = Path(sys.argv[1]), sys.argv[2]
try:
    out = subprocess.run(["bjobs", "-noheader", "-o", "job_name stat exec_host run_time"], capture_output=True, text=True, timeout=30).stdout
except Exception:
    out = ""
lsf = {}
for line in out.splitlines():
    parts = line.split()
    if len(parts) >= 2 and parts[0].startswith(camp + "."):
        lsf[parts[0][len(camp) + 1:]] = (parts[1], parts[2] if len(parts) > 2 else "-")
print(f"{'cell':44} {'lsf':6} {'host':18} {'evals':>5} {'valid':>5} {'best':>14} {'last':>7} outcome")
for d in sorted(p for p in root.iterdir() if (p / "cell.json").is_file()):
    rows = []
    try:
        rows = [json.loads(l) for l in (d / "iterations.jsonl").read_text().splitlines() if l.strip()]
    except FileNotFoundError:
        pass
    best = None
    try:
        best = json.loads((d / "best.json").read_text()).get("score")
    except (OSError, ValueError):
        pass
    last = "-"
    if rows:
        last = f"{(time.time() - rows[-1]['t']) / 60:.0f}m ago"
    outcome = "-"
    try:
        s = json.loads((d / "session.json").read_text()); outcome = s.get("outcome", "-")
    except (OSError, ValueError):
        pass
    st, host = lsf.get(d.name, ("-", "-"))
    valid = sum(1 for r in rows if r.get("score") is not None)
    print(f"{d.name:44} {st:6} {host:18} {len(rows):5d} {valid:5d} {str(best)[:14]:>14} {last:>7} {outcome}")
PY
