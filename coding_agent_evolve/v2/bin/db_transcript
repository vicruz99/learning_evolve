#!/usr/bin/env python3
"""db_transcript <cell_dir> [--thoughts] [--host HOST]

Render a bnbcode cell's FULL conversation out of its node-local session database.

Why this exists: bnbcode compacts a long session into a *successor* session (see
`[perf] cliff-compaction` in the opencode log). Our ACP client keeps listening on the
session it prompted, so `events.jsonl` goes silent from the first compaction onward even
though the agent keeps working. The session database has everything, including every
successor, so this is the authoritative transcript for bnbcode cells.

The database lives in /tmp on the compute node that runs the cell, so the query is run
there over ssh. When the cell is no longer running the database is gone; the cell's
`pgbackup.sql` (dumped every 2 minutes by bin/launch) is then the only copy.
"""
import argparse, base64, json, os, subprocess, sys, time
from pathlib import Path

SQL = """
select json_build_object(
  'sid', p.session_id,
  'mid', p.message_id,
  'role', m.data->>'role',
  't', p.time_created,
  'type', p.data->>'type',
  'text', left(p.data->>'text', 200000),
  'tool', p.data->>'tool',
  'title', left(p.data#>>'{state,title}', 400),
  'status', p.data#>>'{state,status}',
  'input', left(p.data#>>'{state,input}', 600),
  'output', left(p.data#>>'{state,output}', 600),
  'error', left(p.data#>>'{state,error}', 400)
)::text
from part p left join message m on m.id = p.message_id
order by p.time_created, p.id
"""


def exec_host(camp, cell):
    """Where is this cell running? Ask LSF, fall back to the last host in driver.log."""
    try:
        out = subprocess.run(["bjobs", "-w", "-noheader"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, timeout=60).stdout
        for ln in out.splitlines():
            f = ln.split()
            if len(f) > 6 and f[6] == "%s.%s" % (camp, cell.name) and f[2] == "RUN":
                return f[5].split("*")[-1].split(":")[0]
    except Exception:
        pass
    try:
        for ln in reversed((cell / "driver.log").read_text().splitlines()):
            if " host=" in ln:
                return ln.split(" host=")[1].split()[0]
    except OSError:
        pass
    return None


def fetch(camp, cell, host):
    pgdata = "/tmp/v2pg/%s.%s" % (camp, cell.name)
    v2 = Path(__file__).resolve().parent.parent
    script = (
        "export BNBCODE_PGDATA=%s\n" % pgdata
        + "exec %s/bin/bnbcode-pg-node psql -t -A -c %s\n" % (v2, json.dumps(" ".join(SQL.split())))
    )
    b64 = base64.b64encode(script.encode()).decode()
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=20", host, "echo %s | base64 -d | bash" % b64]
    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True, timeout=600)
    if r.returncode != 0:
        raise RuntimeError("psql on %s failed: %s" % (host, (r.stderr or "")[-400:]))
    rows = []
    for ln in r.stdout.splitlines():
        ln = ln.strip()
        if not ln.startswith("{"):
            continue
        try:
            rows.append(json.loads(ln))
        except ValueError:
            pass
    return rows


# --- reading a pg_dump instead of the live database -------------------------
# Marvin blocks login->compute ssh, so fetch() cannot reach the cell's postgres.
# Every cell re-dumps its store to <cell>/pgbackup.sql every couple of minutes;
# this parses that dump into exactly the rows SQL would have returned.

def _unesc(v):
    """Undo pg_dump COPY text-format escaping."""
    if "\\" not in v:
        return v
    out, i = [], 0
    m = {"n": "\n", "t": "\t", "r": "\r", "b": "\b", "f": "\f", "v": "\v", "\\": "\\"}
    while i < len(v):
        ch = v[i]
        if ch == "\\" and i + 1 < len(v):
            nxt = v[i + 1]
            if nxt in m:
                out.append(m[nxt])
                i += 2
                continue
        out.append(ch)
        i += 1
    return "".join(out)


def _copy_blocks(text):
    """Yield (table, [column names], [row-as-list-of-raw-strings]) for each COPY block."""
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        ln = lines[i]
        if ln.startswith("COPY ") and ln.rstrip().endswith("FROM stdin;"):
            head = ln[len("COPY "):]
            table = head.split(" ", 1)[0].split("(")[0].strip()
            cols = []
            if "(" in head:
                cols = [c.strip().strip('"') for c in head[head.index("(") + 1:head.rindex(")")].split(",")]
            rows = []
            i += 1
            while i < len(lines) and lines[i] != "\\.":
                rows.append(lines[i].split("\t"))
                i += 1
            yield table, cols, rows
        i += 1


def rows_from_dump(path):
    """Parse <cell>/pgbackup.sql into the same row dicts fetch() returns."""
    text = Path(path).read_text(errors="replace")
    roles, parts = {}, []
    for table, cols, raw in _copy_blocks(text):
        short = table.split(".")[-1]
        if short not in ("message", "part"):
            continue
        idx = {c: n for n, c in enumerate(cols)}
        for r in raw:
            def col(name):
                n = idx.get(name)
                if n is None or n >= len(r) or r[n] == "\\N":
                    return None
                return _unesc(r[n])

            data = col("data")
            try:
                data = json.loads(data) if data else {}
            except ValueError:
                data = {}
            if short == "message":
                roles[col("id")] = data.get("role")
                continue
            st = data.get("state") or {}
            if not isinstance(st, dict):
                st = {}

            def s(v, n):
                if v is None:
                    return None
                v = v if isinstance(v, str) else json.dumps(v)
                return v[:n]

            t = col("time_created")
            try:
                t = int(float(t)) if t is not None else 0
            except ValueError:
                t = 0
            parts.append({
                "sid": col("session_id"),
                "mid": col("message_id"),
                "role": None,
                "t": t,
                "type": data.get("type"),
                "text": s(data.get("text"), 200000),
                "tool": data.get("tool"),
                "title": s(st.get("title"), 400),
                "status": s(st.get("status"), 400),
                "input": s(st.get("input"), 600),
                "output": s(st.get("output"), 600),
                "error": s(st.get("error"), 400),
                "_id": col("id") or "",
            })
    for r in parts:
        r["role"] = roles.get(r["mid"])
    parts.sort(key=lambda r: (r["t"], r["_id"]))
    return parts


def render(rows, thoughts):
    out = []
    sid = None
    for r in rows:
        t = time.strftime("%H:%M:%S", time.localtime((r.get("t") or 0) / 1000))
        if r.get("sid") != sid:
            sid = r.get("sid")
            out.append("\n%s ###### SESSION %s\n" % (t, sid))
        typ = r.get("type")
        if typ == "text":
            txt = (r.get("text") or "").strip()
            if txt:
                who = "USER/HOST" if r.get("role") == "user" else "assistant"
                out.append("%s [%s] %s\n" % (t, who, txt))
        elif typ == "reasoning":
            if thoughts and (r.get("text") or "").strip():
                out.append("%s   [thinking] %s\n" % (t, r["text"].strip().replace("\n", "\n   ")))
        elif typ == "tool":
            head = "%s >> %s: %s" % (t, r.get("tool"), (r.get("title") or "").replace("\n", " ")[:300])
            body = ""
            if r.get("output"):
                body = "\n%s << %s" % (t, r["output"].replace("\n", " ")[:300])
            if r.get("error"):
                body += "\n%s << ERROR %s" % (t, r["error"].replace("\n", " ")[:300])
            out.append(head + body)
        elif typ == "compaction":
            out.append("%s ###### COMPACTION (bnbcode moved this conversation to a successor session)" % t)
    return "\n".join(out) + "\n"


def cell_rows(cell, host=None, dump=None):
    """Live database when we can reach the compute node, else the cell's dump."""
    if dump == "always":
        return rows_from_dump(cell / "pgbackup.sql"), "pgbackup.sql"
    camp = cell.parent.name
    host = host or exec_host(camp, cell)
    err = None
    if host:
        try:
            return fetch(camp, cell, host), host
        except Exception as e:          # ssh refused (Marvin), node gone, psql failed
            err = e
    else:
        err = RuntimeError("not running, and driver.log names no host")
    if dump == "never":
        raise RuntimeError("no live store for %s/%s: %s" % (cell.parent.name, cell.name, err))
    p = cell / "pgbackup.sql"
    if not p.exists():
        raise RuntimeError("no live store (%s) and no %s" % (err, p))
    sys.stderr.write("live store unreachable (%s); reading %s\n" % (str(err)[:120], p.name))
    return rows_from_dump(p), "pgbackup.sql"


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cell", type=Path)
    ap.add_argument("--thoughts", action="store_true")
    ap.add_argument("--host")
    ap.add_argument("--dump", choices=["auto", "always", "never"], default="auto",
                    help="read <cell>/pgbackup.sql instead of the live store "
                         "(auto: only if the store is unreachable, as on Marvin)")
    a = ap.parse_args()
    rows, host = cell_rows(a.cell.resolve(), a.host, a.dump)
    sys.stderr.write("%d parts from %s\n" % (len(rows), host))
    sys.stdout.write(render(rows, a.thoughts))


if __name__ == "__main__":
    main()
