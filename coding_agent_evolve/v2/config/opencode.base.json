{
  "_comment": "Per-cell bnbcode config, completed by driver/mkcell.py (model, provider, limits, continual_work, tool_output, compaction, reasoning). The permission block is the campaign's (experiments/opencode.json) plus denies for the tracker files; read it side by side with claude_guard.json -- keeping the two arms' freedoms equal is the point. bash denies are a guardrail against accident, not a sandbox.",
  "permission": {
    "doom_loop": "allow",
    "question": "deny",
    "webfetch": "deny",
    "codesearch": "deny",
    "arxiv": "deny",
    "wiki": "deny",
    "external_directory": {
      "*": "deny",
      "/tmp/*": "allow"
    },
    "edit": {
      "*": "allow",
      "*/venvs/*": "deny",
      "*/work/*": "deny",
      "*/.ssh/*": "deny",
      "*/.config/*": "deny",
      "*/.llmtun/*": "deny",
      "/proc/*": "deny",
      "/sys/*": "deny",
      "*eval.py": "deny",
      "*_official_evaluator.py": "deny",
      "*_adrs_track.json": "deny",
      "*opencode.json": "deny",
      "*INITIAL_PROMPT.md": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "sudo *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "bsub *": "deny",
      "bkill *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "pip install *": "deny",
      "uv pip install *": "deny",
      "git push *": "deny",
      "chmod *": "deny"
    }
  }
}
