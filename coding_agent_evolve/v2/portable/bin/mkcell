#!/usr/bin/env bash
# mkcell <cell_name> <AC1|AC2> <evo|plain> <bnb|cc>
#
# Builds one run folder from the task templates. Every cell is created the same way, so the
# only differences between cells are the ones under test.
#
# The prompt is a template because a few of its sentences describe the *site* (interpreter
# path, core budget, time budget) rather than the task. Those must match what the run is
# actually given -- an agent told it has 32 cores on a 16-core box oversubscribes and its
# own timings stop meaning anything. Everything else is copied byte-for-byte from the
# Bosch campaign, because that text IS the experimental condition.
set -eu

NAME=${1:?usage: mkcell <name> <AC1|AC2> <evo|plain> <bnb|cc>}
TASK=${2:?}
VAR=${3:?}
HARNESS=${4:?}

KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEST="${RUNS_ROOT:-$HOME/agent_runs}/$NAME"

CORES=${CELL_CORES:-16}
HOURS=${CELL_HOURS:-6}
PYTHON=${AGENT_PYTHON:-python3}
PARALLEL=$(( CORES / 2 ))

case "$TASK" in
  AC1) START_SCORE="2.0" ;;
  AC2) START_SCORE="0.6667" ;;   # NOT 2.0 -- see PROMPT_DEVIATIONS.md
  *) echo "unknown task: $TASK" >&2; exit 1 ;;
esac

[ -d "$DEST" ] && { echo "exists already, refusing to clobber: $DEST" >&2; exit 1; }
mkdir -p "$DEST/run"

cp "$KIT/tasks/$TASK/eval.py" "$DEST/eval.py"
cp "$KIT/tasks/$TASK/height_sequence_1.npy" "$DEST/"

VENUE=${CELL_VENUE:-"- **Where you are**: a batch job on a shared machine. \`nproc\` reports how many
  cores it was given. There is no GPU and you do not need one."}

PYTHON_BLOCK=${CELL_PYTHON_BLOCK:-"- **Python**: \`$PYTHON\` — use that interpreter, not a bare \`python\`. numpy, scipy and cvxpy
  are installed. **Do not create another virtual environment** and do not install packages: if
  you genuinely need a library that is not there, say so in your final report instead of
  working around it."}

python3 - "$KIT/tasks/$TASK/prompt_$VAR.md" "$DEST/INITIAL_PROMPT.md" <<PY
import io, sys
src, dst = sys.argv[1], sys.argv[2]
s = io.open(src, encoding="utf-8").read()
for k, v in (("{{CORES}}", "$CORES"), ("{{PARALLEL}}", "$PARALLEL"),
             ("{{HOURS}}", "$HOURS"), ("{{PYTHON}}", "$PYTHON"),
             ("{{START_SCORE}}", "$START_SCORE"),
             ("{{VENUE}}", """$VENUE"""),
             ("{{PYTHON_BLOCK}}", """$PYTHON_BLOCK""")):
    s = s.replace(k, v)
left = [w for w in ("{{CORES}}","{{PARALLEL}}","{{HOURS}}","{{PYTHON}}","{{START_SCORE}}",
                    "{{VENUE}}","{{PYTHON_BLOCK}}") if w in s]
if left:
    sys.exit("unrendered placeholders remain: %s" % left)
io.open(dst, "w", encoding="utf-8").write(s)
PY

case "$HARNESS" in
  bnb) cp "$KIT/config/opencode_run.json" "$DEST/opencode.json" ;;
  cc)  : ;;   # Claude Code takes its settings on the command line, outside the editable dir
  *) echo "unknown harness: $HARNESS" >&2; exit 1 ;;
esac

printf '%s\n' "task=$TASK variant=$VAR harness=$HARNESS cores=$CORES hours=$HOURS" \
  > "$DEST/run/CELL.txt"

echo "created $DEST"
ls "$DEST"
