#!/bin/bash
#BSUB -q batch_cpu
#BSUB -P BH-000557-01
#BSUB -n 2
#BSUB -R "span[hosts=1] rusage[mem=4096]"
#BSUB -W 0:20
#BSUB -J regdryrun
#BSUB -o lsf.out
#BSUB -e lsf.err
# Full AC2 dry run of the registry on a compute node: init, two submits, checks, pending sweep, export.
set -u
export PATH=$HOME/.local/bin:$PATH
PY=$HOME/venvs/agent-eval/bin/python
D=$HOME/agent_runs/registry_dryrun
rm -rf $D; mkdir -p $D/run/attempts; cd $D
echo "host=$(hostname)"
echo "=== init"; registry init --problem AC2 --baseline-expect 0.6667 || exit 1
$PY -c "import numpy as np; n=16384; x=np.linspace(-1,1,n); np.save('run/attempts/gauss.npy', np.exp(-4*x*x))"
printf 'import numpy as np\n# gaussian bump, n=16384\n' > run/attempts/gauss.py
echo "=== manual eval (n=16384):"; time $PY eval.py run/attempts/gauss.npy
C=$($PY eval.py run/attempts/gauss.npy | sed -n 's/^SCORE *= *\([0-9.e+-]*\).*/\1/p')
echo "=== submit claimed=$C"
registry submit --desc "gaussian bump" --artifact run/attempts/gauss.npy --program run/attempts/gauss.py --claimed $C --runtime 1 --config '{"n":16384,"shape":"gauss"}' --parents 0 --tag gauss
echo "=== second: flat box, claimed 0.6 -> skipped by policy"
$PY -c "import numpy as np; np.save('run/attempts/box.npy', np.ones(4096))"
registry submit --desc "flat box" --artifact run/attempts/box.npy --claimed 0.6 --parents 0 --tag box
echo "=== note"; registry submit --kind note --desc "bound analysis: flat-top C<=0.95" --tag bounds
echo "=== list"; registry list
echo "=== best"; registry best
echo "=== sha check (best.npy == artifact 1 == best.json)"; sha256sum run/best.npy run/registry/artifacts/000001.npy | cut -c1-24; grep sha256 run/registry/best.json
echo "=== lineage 1"; registry lineage 1
echo "=== eval --pending (box gets verified)"; registry eval --pending
echo "=== show 2"; registry show 2 | grep -E "^(score|claimed|eval_status|artifact_drift)"
echo "=== export rows: $(registry export | wc -l)"; registry export --csv export.csv
registry config | grep -E "journal|tool_sha"
echo "=== agent-style mistakes"; registry submit --kind note --desc x --claimed 0.9; echo "rc=$?"; registry submit --desc x --artifact run/attempts/box.npy --parents 77; echo "rc=$?"
echo DRYRUN_DONE
